# Sandbox harness spec for the express-crud fixture (docs/phase2-plan.md section 11, migrate/harness.py).
# Paths are relative to the service source tree (legacy_src/ once imported). Named .yaml.in so Phase 1 does
# not analyse it as service config; `harness build` copies it to <project>/harness/harness.yaml.
schema_version: 1
name: express-crud
legacy:
  image: ma-fixture/express-crud:legacy
  dockerfile: harness/Dockerfile
  context: harness
  workdir: /work/app
  build:
    # No lockfile in the fixture (TODO: commit package-lock.json; plan 6 requires lockfiles).
    # `dotenv` is required by src/config/index.js but missing from package.json (a real fixture quirk),
    # so the harness installs it without saving. Point npm_config_registry at your mirror and list its
    # host in harness/mirror.json (or MA_MIRROR_HOSTS); with no mirror the build runs offline from /cache.
    command:
      - sh
      - -c
      - npm install --omit=dev --no-audit --no-fund --cache /cache --prefer-offline && npm install --no-save --no-audit --no-fund --cache /cache --prefer-offline dotenv@16.4.5
    network: mirror
    cache: harness/cache/npm
    timeout_s: 1800
    env:
      npm_config_registry: https://registry.npmjs.org/
  start: [node, src/server.js]
  port: 3000
  healthcheck:
    path: /api/products
    command:
      - node
      - -e
      - "require('http').get('http://127.0.0.1:{port}{path}', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
    timeout_s: 120
  env:
    PORT: "3000"
    DB_URL: "sqlite::memory:"
    MAX_ORDER_ITEMS: "20"
  synthetic_secrets: [API_TOKEN]
  # The service rejects every /api call without x-api-token. The token is random per `harness up`; the runner adds
  # it to every request it sends (recording, seeds, equivalence). Without this every case would answer 401.
  request_headers:
    X-API-Token: "{secret:API_TOKEN}"
  limits: {cpus: 1.0, memory_mb: 1024, pids: 256, timeout_s: 900, disk_mb: 1024}
db:
  engine: sqlite      # in-memory (DB_URL sqlite::memory:); tables come from sequelize.sync() at start-up
# The database lives inside the process, so seed data goes through the API (used by the M3 recorder):
seed_requests: harness/seed/requests.json
