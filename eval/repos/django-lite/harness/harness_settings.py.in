# Harness settings for django-lite, copied to /work/app/harness_settings.py by the harness build job.
# Kept as .py.in so Phase 1 analysis does not treat it as part of the legacy service.
# The fixture's library/settings.py has no SECRET_KEY/ALLOWED_HOSTS and an incomplete 0001 migration, so the
# harness creates tables straight from the models (MIGRATION_MODULES None + migrate --run-syncdb).
import os

from library.settings import *  # noqa: F401,F403

SECRET_KEY = os.environ["DJANGO_SECRET_KEY"]   # synthetic, random per `harness up`
DEBUG = False
ALLOWED_HOSTS = ["*"]
USE_TZ = True
DEFAULT_AUTO_FIELD = "django.db.models.AutoField"
DATABASES = {"default": {"ENGINE": "django.db.backends.sqlite3",
                         "NAME": os.environ.get("DB_PATH", "/work/app/db.sqlite3")}}
MIGRATION_MODULES = {"library": None}
